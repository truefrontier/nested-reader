{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Reader, settings and page windows",
  "windows": ["main", "settings", "page-*"],
  "permissions": [
    "core:default",
    "core:window:allow-set-focus",
    "core:window:allow-show",
    "core:window:allow-close",
    "opener:default",
    "dialog:default",
    "aptabase:allow-track-event"
  ]
}
